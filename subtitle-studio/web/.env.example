# Sao chép thành .env rồi điền
SECRET_KEY=                 # chuỗi ngẫu nhiên dài; bỏ trống = tự sinh và lưu trong data/secret.key
COOKIE_SECURE=0             # đặt 1 khi chạy qua HTTPS
MAX_UPLOAD_MB=2048

# Đăng nhập Google (Google Cloud Console > Credentials > OAuth client ID > Web application)
GOOGLE_CLIENT_ID=

# Lưu video: local | cloudinary
STORAGE=local
CLOUDINARY_URL=             # cloudinary://API_KEY:API_SECRET@CLOUD_NAME (chỉ khi STORAGE=cloudinary)

# Model server GPU (bỏ trống MODEL_API_URL = dùng dữ liệu mẫu)
MODEL_API_URL=
MODEL_API_KEY=
